diff --git a/src/styles/ineshast.css b/src/styles/ineshast.css
new file mode 100644
index 00000000..85b05ba2
--- /dev/null
+++ b/src/styles/ineshast.css
@@ -0,0 +1,215 @@
+@font-face {
+  font-family: IranYekan;
+  src: url('../assets/ineshast/regular.woff') format('woff');
+  font-weight: 400 500;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: IranYekan;
+  src: url('../assets/ineshast/bold.woff') format('woff');
+  font-weight: 600 900;
+  font-display: swap;
+}
+
+body, button, input, select, textarea {
+  font-family: IranYekan, sans-serif;
+}
+
+#startupJoinModal {
+  isolation: isolate;
+  inset: 0;
+  overflow: auto;
+  padding: clamp(12px, 4vw, 42px);
+  background: #f7f8fd;
+}
+
+.dark #startupJoinModal {
+  background: #0d1020;
+}
+
+#startupJoinModal::before {
+  content: '';
+  position: fixed;
+  inset: -12%;
+  z-index: -1;
+  pointer-events: none;
+  background:
+    radial-gradient(ellipse at 78% 24%, #a78bfa65, transparent 47%),
+    radial-gradient(ellipse at 20% 72%, #4f46e54d, transparent 48%),
+    radial-gradient(ellipse at 70% 95%, #818cf84d, transparent 45%);
+  animation: ineshast-aurora 18s ease-in-out infinite alternate;
+}
+
+@keyframes ineshast-aurora {
+  from { transform: translate(-2%, 1%) scale(1); }
+  to { transform: translate(4%, -3%) scale(1.12); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  #startupJoinModal::before { animation: none; }
+}
+
+#startupJoinModal > .inner {
+  border-radius: 24px;
+  box-shadow: 0 22px 72px #16123938;
+}
+
+#startupJoinModal > .inner > .head {
+  min-height: 64px;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.ineshast-entry-logo {
+  display: block;
+  width: clamp(90px, 12vw, 128px);
+  height: auto;
+}
+
+#startupJoinModal .camera {
+  background: radial-gradient(ellipse at 70% 20%, #37346a, #141830 70%);
+}
+
+#startupJoinModal .primary-button:not(:disabled) {
+  background: #4f46e5;
+  border-color: #6366f1;
+  color: #fff;
+}
+
+#startupJoinModal .primary-button:not(:disabled):hover {
+  background: #4338ca;
+}
+
+#startupJoinModal button:focus-visible,
+.ineshast-camera-strip > .inner:focus-visible {
+  outline: 2px solid #818cf8;
+  outline-offset: 2px;
+}
+
+@media (max-width: 767px) {
+  #startupJoinModal .camera { height: clamp(96px, 24vh, 168px); }
+  #startupJoinModal .micro-cam-wrap { padding-block: 8px; }
+  #startupJoinModal .buttons { padding-block-start: 16px; }
+}
+
+#main-header, #main-footer {
+  box-shadow: 0 0 24px #15134216;
+}
+
+#main-area {
+  --ineshast-camera-height: clamp(78px, 15vh, 142px);
+}
+
+#main-area .middle-fullscreen-wrapper:has(> .ineshast-camera-strip) {
+  padding: var(--ineshast-camera-height) 0 0 !important;
+}
+
+#main-area .ineshast-camera-strip {
+  inset: 0 0 auto !important;
+  width: 100% !important;
+  height: var(--ineshast-camera-height) !important;
+  padding: 6px 12px !important;
+  border: 0;
+  border-bottom: 1px solid var(--color-Gray-300);
+  display: flex;
+  flex-direction: row;
+  justify-content: start;
+}
+
+.dark #main-area .ineshast-camera-strip {
+  border-color: var(--color-Gray-700);
+}
+
+#main-area .ineshast-camera-strip > .inner {
+  flex-flow: row nowrap !important;
+  align-items: center;
+  justify-content: start !important;
+  overflow-x: auto;
+  overflow-y: hidden;
+  scrollbar-width: thin;
+  scrollbar-color: #818cf8 transparent;
+}
+
+#main-area .ineshast-camera-strip > .inner > [class*='camera-row-']:not(.pinCam-item) {
+  display: contents !important;
+}
+
+#main-area .ineshast-camera-strip .video-camera-item,
+#main-area .ineshast-camera-strip .webcam-next-page,
+#main-area .ineshast-camera-strip .webcam-prev-page {
+  flex: 0 0 auto !important;
+  aspect-ratio: 16 / 9;
+  height: calc(var(--ineshast-camera-height) - 23px) !important;
+  width: auto !important;
+  min-width: 0 !important;
+  max-width: none !important;
+  margin: 0 !important;
+  border-radius: 12px;
+}
+
+.ineshast-record-label {
+  font-size: 11px;
+  font-weight: 700;
+}
+
+#message-textarea { direction: rtl; text-align: right; }
+#main-footer .footer-right .tooltip { inset-inline-start: 0; inset-inline-end: auto; text-align: center; }
+#main-footer .footer-left .tooltip { inset-inline-end: 0; inset-inline-start: auto; }
+#main-footer .micro-muted-tooltip { inset-inline-start: auto !important; inset-inline-end: 0 !important; max-width: min(300px, 90vw); }
+.ineshast-camera-strip .video-camera-item-inner { overflow: hidden; border-radius: 12px; }
+
+.ineshast-loading {
+  position: fixed; inset: 0; z-index: 999; display: grid; place-items: center;
+  overflow: hidden; isolation: isolate; background: #f7f8fd; color: #18213a;
+}
+body.dark .ineshast-loading { background: #0d1020; color: #f5f4ff; }
+.ineshast-loading::before, #startupJoinModal::after {
+  content: ''; position: fixed; inset: -25%; z-index: -1; pointer-events: none;
+  background: radial-gradient(ellipse at 22% 28%, #a78bfa80, transparent 34%),
+    radial-gradient(ellipse at 76% 68%, #6366f166, transparent 34%),
+    radial-gradient(ellipse at 53% 50%, #e0e7ff99, transparent 46%);
+  animation: ineshast-aurora 16s ease-in-out infinite alternate;
+}
+body.dark .ineshast-loading::before, body.dark #startupJoinModal::after {
+  background: radial-gradient(ellipse at 22% 28%, #6d28d950, transparent 34%),
+    radial-gradient(ellipse at 76% 68%, #4338ca60, transparent 34%),
+    radial-gradient(ellipse at 53% 50%, #1e1b4b88, transparent 46%);
+}
+.ineshast-loading-card { display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 38px 52px; border-radius: 26px; background: #ffffffc9; box-shadow: 0 24px 80px #312e8130; backdrop-filter: blur(18px); }
+body.dark .ineshast-loading-card { background: #171b32d9; }
+.ineshast-loading-card img { width: 155px; height: auto; }
+.ineshast-loading-card p { margin: 0; font-size: 14px; }
+.ineshast-loading-spinner { width: 32px; height: 32px; animation: spin 1s linear infinite; }
+#startupJoinModal::after { opacity: .7; animation-direction: alternate-reverse; }
+@media (prefers-reduced-motion: reduce) { .ineshast-loading::before, #startupJoinModal::after { animation: none; } }
+.ineshast-camera-strip .video-camera-item-inner > .name { bottom: 4px; padding: 3px 8px; font-size: 11px; line-height: 1.4; max-height: 38%; overflow: hidden; background: linear-gradient(transparent, #000a); }
+#main-footer .micro-muted-tooltip .inner { width: min(300px, 86vw); white-space: normal; }
+
+#main-footer .footer-left .microphone-wrap .tooltip { left: 0 !important; right: auto !important; }
+#main-footer .footer-right .tooltip { white-space: normal; max-width: min(220px, 80vw); }
+.search-participants-wrap input::placeholder, #message-textarea::placeholder { text-align: right; direction: rtl; }
+
+/* Keep each tooltip centered on its own control. */
+#main-footer .footer-right .participants .tooltip,
+#main-footer .footer-right .message .tooltip {
+  inset-inline-start: auto; inset-inline-end: auto; left: 50% !important; right: auto !important;
+  transform: translateX(-50%);
+}
+#main-footer .footer-right .participants .tooltip::before,
+#main-footer .footer-right .message .tooltip::before {
+  left: 50%; right: auto; margin: 0; transform: translateX(-50%) rotate(45deg);
+}
+#main-header .right { gap: 0.5rem; min-width: 0; }
+.ineshast-entry-art { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
+.ineshast-entry-orbit { position: absolute; border: 1px solid #8074eb55; border-radius: 50%; box-shadow: inset 0 0 55px #a78bfa19, 0 0 55px #a78bfa22; }
+.ineshast-entry-orbit-one { width: min(54vw, 650px); aspect-ratio: 1; top: -26%; right: -10%; animation: ineshast-orbit-one 13s ease-in-out infinite alternate; }
+.ineshast-entry-orbit-two { width: min(46vw, 540px); aspect-ratio: 1; bottom: -28%; left: -8%; border-width: 2px; animation: ineshast-orbit-two 17s ease-in-out infinite alternate; }
+.ineshast-entry-spark { position: absolute; border-radius: 50%; background: #7464ef; box-shadow: 0 0 18px #8b5cf6, 0 0 42px #a78bfa; animation: ineshast-spark 4s ease-in-out infinite alternate; }
+.ineshast-entry-spark-one { width: 9px; height: 9px; top: 19%; right: 17%; }
+.ineshast-entry-spark-two { width: 7px; height: 7px; bottom: 19%; left: 18%; animation-delay: -1.7s; }
+.ineshast-entry-spark-three { width: 5px; height: 5px; top: 36%; left: 10%; animation-delay: -3s; }
+@keyframes ineshast-orbit-one { from { transform: translate(-4%, 3%) scale(.9); } to { transform: translate(7%, 8%) scale(1.15); } }
+@keyframes ineshast-orbit-two { from { transform: translate(7%, -4%) scale(1.08); } to { transform: translate(-5%, -12%) scale(.9); } }
+@keyframes ineshast-spark { from { opacity: .35; transform: translateY(0) scale(.75); } to { opacity: 1; transform: translateY(-20px) scale(1.3); } }
+@media (prefers-reduced-motion: reduce) { .ineshast-entry-orbit, .ineshast-entry-spark { animation: none; } }
